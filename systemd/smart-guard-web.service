[Unit]
Description=Smart Guard HTTPS Dashboard and Control API
Documentation=file:/opt/smart-guard/README.md
Wants=network-online.target smart-guard-command.service
After=network-online.target smart-guard-watchdog.service smart-guard-command.service

[Service]
Type=simple
User=smartguard
Group=smartguard
WorkingDirectory=/opt/smart-guard
EnvironmentFile=/etc/smart-guard/config.env
ExecStart=/opt/smart-guard/bin/smart-guard-web

Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

RuntimeDirectory=smart-guard
RuntimeDirectoryMode=0750
StateDirectory=smart-guard
StateDirectoryMode=0770
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/run/smart-guard /etc/smart-guard
ReadWritePaths=/var/lib/smart-guard

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
