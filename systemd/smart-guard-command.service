[Unit]
Description=Smart Guard Allowlisted Command Runner
Documentation=file:/opt/smart-guard/README.md
Before=smart-guard-web.service

[Service]
Type=simple
User=root
Group=smartguard
WorkingDirectory=/opt/smart-guard
EnvironmentFile=/etc/smart-guard/config.env
ExecStart=/opt/smart-guard/bin/smart-guard-command

Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

StateDirectory=smart-guard
StateDirectoryMode=0770
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/smart-guard
ReadWritePaths=/var/lib/smart-guard

CapabilityBoundingSet=CAP_SYS_BOOT
AmbientCapabilities=CAP_SYS_BOOT

[Install]
WantedBy=multi-user.target
