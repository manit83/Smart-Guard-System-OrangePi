# Identity
STUDENT_ID=YOUR_STUDENT_ID
STUDENT_NAME="YOUR FULL NAME"

# Web dashboard and TLS
BOARD_BIND_IP=0.0.0.0
BOARD_PUBLIC_HOST=
HTTP_PORT=80
HTTPS_PORT=443
TELEMETRY_INTERVAL_SEC=2
FRAME_MAX_AGE_SEC=5
MJPEG_STREAM_FPS=2

PROJECT_ROOT=/opt/smart-guard
WEB_ROOT=/opt/smart-guard/web
RUN_DIR=/run/smart-guard
LATEST_FRAME_PATH=/run/smart-guard/latest.jpg
VISION_STATE_PATH=/run/smart-guard/vision-state.json
TLS_CERT_PATH=/etc/smart-guard/tls/server.crt
TLS_KEY_PATH=/etc/smart-guard/tls/server.key
LOG_LEVEL=INFO

# Allowlisted command API and privileged command runner
COMMAND_REQUEST_PATH=/var/lib/smart-guard/command-request
COMMAND_POLL_INTERVAL_MS=250
COMMAND_REBOOT_ENABLED=1
COMMAND_REBOOT_DELAY_SEC=2

# USB camera and OpenCV vision
CAMERA_SOURCE=v4l2
CAMERA_DEVICE=auto
CAMERA_BACKEND=auto
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_INPUT_FPS=10
CAMERA_INPUT_FORMAT=auto
CAMERA_READY_TIMEOUT_SEC=30
CAMERA_RECONNECT_DELAY_SEC=2

VISION_OUTPUT_FPS=2
VISION_JPEG_QUALITY=82
VISION_DETECTION_WIDTH=320
VISION_DETECTOR=face
FACE_CASCADE_PATH=auto
FACE_SCALE_FACTOR=1.10
FACE_MIN_NEIGHBORS=5
FACE_MIN_SIZE=36
VISION_PYTHON=/usr/bin/python3

# Optional ONVIF/RTSP camera
ONVIF_HOST=
ONVIF_PORT=80
ONVIF_USERNAME=
ONVIF_PASSWORD_FILE=/etc/smart-guard/onvif-password
ONVIF_PROFILE_TOKEN=

# Email notification
NOTIFIER_POLL_INTERVAL_MS=250
CPU_TEMP_PATH=auto
LAST_EMAIL_STATE_PATH=/var/lib/smart-guard/last-email-attempt

EMAIL_ENABLED=0
EMAIL_TO=receiver@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=sender@gmail.com
SMTP_FROM=sender@gmail.com
SMTP_PASSWORD_FILE=/etc/smart-guard/smtp-password
SMTP_CA_FILE=
EMAIL_SUBJECT_PREFIX="Smart Guard"
EMAIL_DEBOUNCE_SEC=30

# MQTT client; the broker runs on the Ubuntu PC
MQTT_ENABLED=0
MQTT_BROKER_HOST=192.168.1.10
MQTT_BROKER_PORT=1883
MQTT_USERNAME=smartguard
MQTT_PASSWORD_FILE=/etc/smart-guard/mqtt-password
MQTT_KEEPALIVE_SEC=15
MQTT_PERSONS_INTERVAL_SEC=1
MQTT_TELEMETRY_INTERVAL_SEC=5

# Guard mode, SQLite history and software watchdog
GUARD_STATE_PATH=/var/lib/smart-guard/guard-mode
GUARD_DEFAULT_ENABLED=0
GUARD_ALERT_DEBOUNCE_SEC=30
LAST_GUARD_ALERT_STATE_PATH=/var/lib/smart-guard/last-guard-alert-attempt

HISTORY_DB_PATH=/var/lib/smart-guard/history.db
HISTORY_CAPACITY=1000
HISTORY_EVENT_REARM_SEC=2

WATCHDOG_FRAME_TIMEOUT_SEC=30
WATCHDOG_POLL_INTERVAL_MS=500
WATCHDOG_EMAIL_ENABLED=0
WATCHDOG_RESTART_ENABLED=1
WATCHDOG_RESTART_SERVICE=smart-guard-vision.service
WATCHDOG_INCIDENT_DEBOUNCE_SEC=300
LAST_TAMPER_STATE_PATH=/var/lib/smart-guard/last-tamper-attempt

# Adaptive thermal management
THERMAL_MANAGER_ENABLED=1
THERMAL_HIGH_TEMP_C=70
THERMAL_RECOVERY_TEMP_C=60
THERMAL_POLL_INTERVAL_SEC=2

THERMAL_HOT_CAMERA_WIDTH=320
THERMAL_HOT_CAMERA_HEIGHT=240
THERMAL_HOT_CAMERA_INPUT_FPS=5
THERMAL_HOT_VISION_OUTPUT_FPS=1
THERMAL_HOT_DETECTION_WIDTH=240

THERMAL_EMAIL_ENABLED=0
THERMAL_EMAIL_RETRY_SEC=60
THERMAL_RESTART_ENABLED=1
THERMAL_RESTART_SERVICE=smart-guard-vision.service

THERMAL_OVERRIDE_PATH=/run/smart-guard/vision-thermal.env
THERMAL_STATUS_PATH=/run/smart-guard/thermal-status.json
THERMAL_STATE_PATH=/var/lib/smart-guard/thermal-mode
THERMAL_LAST_EMAIL_MODE_PATH=/var/lib/smart-guard/thermal-last-email-mode
THERMAL_LAST_EMAIL_ATTEMPT_PATH=/var/lib/smart-guard/thermal-last-email-attempt
